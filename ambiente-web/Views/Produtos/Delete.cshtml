@model ambiente_web.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-white transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Voltar
    </a>
</div>

<h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Excluir Produto</h1>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 max-w-md transition-colors duration-300">
    <p class="text-gray-600 dark:text-gray-300 mb-4">Tem certeza que deseja excluir este produto?</p>

    <dl class="space-y-2 mb-6">
        <div>
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Nome</dt>
            <dd class="text-gray-800 dark:text-white">@Html.DisplayFor(model => model.Nome)</dd>
        </div>
        <div>
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Preço</dt>
            <dd class="text-gray-800 dark:text-white">@Html.DisplayFor(model => model.Preco)</dd>
        </div>
    </dl>

    <form asp-action="Delete" class="flex space-x-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="bg-red-600 dark:bg-red-700 text-white px-4 py-2 rounded-lg hover:bg-red-700 dark:hover:bg-red-800 transition">
            Excluir
        </button>
        <a asp-action="Index" class="text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 py-2 transition">
            Voltar
        </a>
    </form>
</div>
