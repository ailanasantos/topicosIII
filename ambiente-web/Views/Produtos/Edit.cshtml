@model ambiente_web.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-white transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Voltar
    </a>
</div>

<h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Editar Produto</h1>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 max-w-md transition-colors duration-300">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-red-500 dark:text-red-400 mb-4"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-4">
            <label asp-for="Nome" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Nome" class="w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
            <span asp-validation-for="Nome" class="text-red-500 dark:text-red-400 text-sm"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Preco" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Preco" class="w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors" />
            <span asp-validation-for="Preco" class="text-red-500 dark:text-red-400 text-sm"></span>
        </div>

        <div class="flex space-x-4">
            <button type="submit" class="bg-blue-600 dark:bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition">
                Salvar
            </button>
            <a asp-action="Index" class="text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 py-2 transition">
                Voltar
            </a>
        </div>
    </form>
</div>

