@{
    ViewData["Title"] = "Painel";
}

<div class="text-center py-8">
    <div class="mb-6">
        <svg class="w-20 h-20 mx-auto text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
        </svg>
    </div>
    <h1 class="text-4xl font-bold text-gray-800 dark:text-white mb-4">Mini Supermercado</h1>
    <p class="text-gray-600 dark:text-gray-300 mb-8">Sistema de gerenciamento completo</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <a asp-controller="Vendas" asp-action="Pdv" class="bg-green-600 hover:bg-green-700 text-white rounded-lg shadow-md p-6 transition transform hover:scale-105">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-green-100 text-sm">Abrir PDV</p>
                <p class="text-2xl font-bold">Caixa</p>
            </div>
            <svg class="w-12 h-12 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
        </div>
    </a>

    <a asp-controller="Produtos" asp-action="Index" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-md p-6 transition transform hover:scale-105">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-blue-100 text-sm">Gerenciar</p>
                <p class="text-2xl font-bold">Produtos</p>
            </div>
            <svg class="w-12 h-12 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
        </div>
    </a>

    <a asp-controller="Vendas" asp-action="Index" class="bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md p-6 transition transform hover:scale-105">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-purple-100 text-sm">Histórico</p>
                <p class="text-2xl font-bold">Vendas</p>
            </div>
            <svg class="w-12 h-12 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
        </div>
    </a>

    <a asp-controller="Vendas" asp-action="Relatorios" class="bg-orange-600 hover:bg-orange-700 text-white rounded-lg shadow-md p-6 transition transform hover:scale-105">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-orange-100 text-sm">Ver</p>
                <p class="text-2xl font-bold">Relatórios</p>
            </div>
            <svg class="w-12 h-12 text-orange-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
        </div>
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <a asp-controller="Categorias" asp-action="Index" class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg shadow-md p-6 transition">
        <div class="flex items-center space-x-4">
            <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
            </div>
            <div>
                <p class="text-gray-800 dark:text-white font-semibold">Categorias</p>
                <p class="text-gray-500 dark:text-gray-400 text-sm">Organizar produtos</p>
            </div>
        </div>
    </a>

    <a asp-controller="Clientes" asp-action="Index" class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg shadow-md p-6 transition">
        <div class="flex items-center space-x-4">
            <div class="bg-green-100 dark:bg-green-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-gray-800 dark:text-white font-semibold">Clientes</p>
                <p class="text-gray-500 dark:text-gray-400 text-sm">Cadastro de clientes</p>
            </div>
        </div>
    </a>

    <a asp-controller="Produtos" asp-action="Create" class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg shadow-md p-6 transition">
        <div class="flex items-center space-x-4">
            <div class="bg-purple-100 dark:bg-purple-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <p class="text-gray-800 dark:text-white font-semibold">Novo Produto</p>
                <p class="text-gray-500 dark:text-gray-400 text-sm">Cadastrar produto</p>
            </div>
        </div>
    </a>
</div>