@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center py-12">
    <h1 class="text-4xl font-bold text-red-600 dark:text-red-400 mb-4">Erro!</h1>
    <p class="text-gray-600 dark:text-gray-300 mb-4">Ocorreu um erro ao processar sua requisição.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-sm text-gray-500 dark:text-gray-400">
            <strong>Request ID:</strong> <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">@Model.RequestId</code>
        </p>
    }
</div>
