@model ambiente_web.Models.Categoria
@{
    ViewData["Title"] = "Excluir Categoria";
}

<a asp-action="Index" class="inline-flex items-center text-blue-600 hover:text-blue-800 dark:text-blue-400 mb-4">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    Voltar
</a>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 max-w-lg">
    <h1 class="text-xl font-bold text-red-600 dark:text-red-400 mb-4">Excluir Categoria</h1>
    <p class="text-gray-600 dark:text-gray-300 mb-4">Tem certeza que deseja excluir esta categoria?</p>
    <dl class="space-y-3 mb-6">
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Nome</dt>
        <dd class="text-gray-800 dark:text-white">@Model.Nome</dd>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Descrição</dt>
        <dd class="text-gray-800 dark:text-white">@(Model.Descricao ?? "-")</dd>
    </dl>
    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">Cancelar</a>
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg">Excluir</button>
        </div>
    </form>
</div>