@model IEnumerable<ambiente_web.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Clientes</h1>
    <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Novo Cliente
    </a>
</div>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
        <input type="text" id="searchInput" placeholder="Buscar clientes..." class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left" id="clientesTable">
            <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider cursor-pointer" onclick="sortTable(0)">Nome</th>
                    <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">CPF</th>
                    <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Telefone</th>
                    <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">E-mail</th>
                    <th class="px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                        <td class="px-6 py-4 whitespace-nowrap text-gray-800 dark:text-white font-medium">@item.Nome</td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300">@(item.CPF ?? "-")</td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300">@(item.Telefone ?? "-")</td>
                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300">@(item.Email ?? "-")</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 mr-3">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 mr-3">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:text-red-900 dark:text-red-400">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="p-8 text-center text-gray-500 dark:text-gray-400">Nenhum cliente encontrado.</div>
    }
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        var filter = this.value.toLowerCase();
        var rows = document.querySelectorAll('#clientesTable tbody tr');
        rows.forEach(function(row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });

    function sortTable(colIndex) {
        var table = document.getElementById('clientesTable');
        var rows = Array.from(table.querySelectorAll('tbody tr'));
        var sorted = rows.sort(function(a, b) {
            var aText = a.cells[colIndex].textContent.toLowerCase();
            var bText = b.cells[colIndex].textContent.toLowerCase();
            return aText.localeCompare(bText);
        });
        var tbody = table.querySelector('tbody');
        tbody.innerHTML = '';
        sorted.forEach(function(row) { tbody.appendChild(row); });
    }
</script>