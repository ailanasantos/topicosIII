@model ambiente_web.Models.Cliente
@{
    ViewData["Title"] = "Novo Cliente";
}

<a asp-action="Index" class="inline-flex items-center text-blue-600 hover:text-blue-800 dark:text-blue-400 mb-4">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    Voltar
</a>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 max-w-lg">
    <h1 class="text-xl font-bold text-gray-800 dark:text-white mb-4">Novo Cliente</h1>
    <form asp-action="Create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
        <div class="mb-4">
            <label asp-for="Nome" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Nome" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
            <span asp-validation-for="Nome" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="CPF" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="CPF" placeholder="000.000.000-00" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
            <span asp-validation-for="CPF" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Telefone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Telefone" placeholder="(00) 00000-0000" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
            <span asp-validation-for="Telefone" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Email" type="email" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Endereco" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
            <input asp-for="Endereco" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" />
            <span asp-validation-for="Endereco" class="text-red-500 text-sm"></span>
        </div>
        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">Cancelar</a>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">Criar</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}